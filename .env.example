# ---- TrimSlot configuration. Copy to .env locally (never commit .env). On Vercel set these in Project -> Settings -> Environment Variables. ----
# Lines marked REQUIRED(prod) make the server refuse to start in production if missing/invalid.

# development | production. Vercel sets NODE_ENV=production for you on deployments.
NODE_ENV=development
PORT=4100

# REQUIRED(prod): Postgres connection string.
#   Vercel + Supabase: Supabase dashboard -> Connect -> "Transaction pooler" (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (URL-encode special characters in the password.)  If EMPTY outside production, local dev uses a throw-away embedded Postgres in ./data/pg.
DATABASE_URL=
# Max connections PER serverless instance. Keep small (1-3) on Vercel + pooler. Default 3. Use 10 on a single long-running server.
PG_POOL_MAX=3
# TLS to Postgres: default = on for remote hosts (encrypted, certificate not verified unless DATABASE_SSL_CA is set), off for localhost.
# DATABASE_SSL=false            # only for a private network Postgres without TLS (e.g. docker-compose)
# DATABASE_SSL_CA=              # PEM contents of the CA (Supabase: Settings -> Database -> SSL certificate) to also verify the server certificate

# REQUIRED(prod): >=32 random chars. Generate: openssl rand -hex 32
JWT_SECRET=

# REQUIRED(prod): public https URL of the app, no trailing slash (Paystack callback + origin checks).
# Vercel: https://<project>.vercel.app  (falls back to VERCEL_PROJECT_PRODUCTION_URL if unset)
APP_BASE_URL=http://localhost:4100

# REQUIRED(prod): Paystack secret key. sk_test_… while testing, sk_live_… to take real money.
# If EMPTY outside production the app runs in clearly-labelled MOCK mode. In production, empty = refuse to boot.
PAYSTACK_SECRET_KEY=

# Secret for /api/cron/sweep (sent as "Authorization: Bearer <CRON_SECRET>"; Vercel Cron does this automatically). >=16 chars.
# Generate: openssl rand -hex 24.  Unset = endpoint disabled (503). Correctness never depends on the sweeper (holds expire lazily).
CRON_SECRET=

# Optional separate key for /admin.html and /api/admin/* (>=16 chars, else ignored). CRON_SECRET still works there as a fallback; the cron endpoint only accepts CRON_SECRET.
# Generate: openssl rand -hex 24
ADMIN_KEY=

# Vercel only: keep the raw request body for Paystack's HMAC signature (also set in vercel.json build.env; set it here as well).
NODEJS_HELPERS=0

# Optional platform fee, taken (as transaction_charge) only on payments for barbers who have a Paystack subaccount.
# PLATFORM_FEE_* is retired: fees are admin settings now (Admin > Controls > Published numbers). Nothing to set here.

# Minutes an unpaid pay-now booking holds its slot (default 15)
PAYMENT_HOLD_MINUTES=15

# Number of reverse proxies in front of the app. Vercel: leave unset/1 (handled). VPS behind Caddy/nginx: 1.
TRUST_PROXY=1

# Extra browser origins allowed to call the API cross-origin, comma separated exact origins. Default: none (same-origin only).
CORS_ORIGINS=

# Demo accounts + demo-login hints. Always ON in development; in production only if SEED_DEMO=true (don't).
SEED_DEMO=

# Structured JSON logs: debug | info | warn | error | silent
LOG_LEVEL=info

# Long-running server only (Docker/VPS/dev): in-process hold sweeper period in seconds (0 = off). Ignored on Vercel - use /api/cron/sweep.
SWEEP_EVERY_SECONDS=60
# Long-running server only: apply /migrations automatically at boot (always on outside production). On Vercel run `npm run migrate` instead.
AUTO_MIGRATE=

# Docker Compose only (LEGACY path): POSTGRES_PASSWORD for the bundled db service, DOMAIN for Caddy, HOST_PORT to publish on 127.0.0.1
POSTGRES_PASSWORD=
DOMAIN=
HOST_PORT=8080

# DEV/TEST ONLY - refused in production: pretend "now" is this instant, e.g. 2026-10-01T10:00:00+01:00
# TRIMSLOT_FAKE_NOW=

# bcrypt cost (default 12 in production, min 10). Lower = faster signup/login on serverless CPUs, slightly weaker against offline cracking.
# BCRYPT_ROUNDS=12
