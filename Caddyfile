# Caddy obtains and renews HTTPS certificates automatically. {$DOMAIN} comes from .env / the environment.
{$DOMAIN} {
	encode zstd gzip

	# The app sends its own security headers (helmet/CSP/HSTS); Caddy just proxies.
	# Caddy sets X-Forwarded-For/Proto itself -> keep TRUST_PROXY=1 (exactly one proxy hop).
	reverse_proxy app:8080 {
		health_uri /healthz
		health_interval 30s
		# Paystack webhooks / slow clients: allow a little time
		transport http {
			response_header_timeout 30s
		}
	}

	request_body {
		max_size 1MB
	}

	log {
		output stdout
		format json
	}
}
